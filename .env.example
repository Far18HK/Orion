TELEGRAM_TOKEN=tu_token_de_botfather
GROQ_API_KEY=tu_api_key_de_groq
# Opcional: varias cuentas de Groq separadas por coma. Si la primera agota su cuota diaria
# (TPD), el bot pasa solo a la siguiente, sin cortar la conversación. Si la defines, pisa a
# GROQ_API_KEY.
# GROQ_API_KEYS=gsk_cuenta1,gsk_cuenta2
GROQ_MODEL=openai/gpt-oss-120b
MAX_HISTORY=20
# 0 = desactivado; 2 = un analista + un sintetizador; 3 = dos analistas + un sintetizador.
# Usa GROQ_API_KEYS con 2 o 3 claves de cuentas distintas para evitar compartir cuota.
MULTI_BRAIN_SIZE=0

# Opcional: deja vacío si no vas a usar notas en Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Límite de mensajes por usuario: máximo N cada X segundos (0 = sin límite)
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW=60
# Lista blanca opcional de ids de Telegram, separados por coma. Vacío = bot público.
# Obtén tu id enviando /id al bot.
ALLOWED_USER_IDS=
# Límite diario por usuario. 0 = sin límite (recomendado definirlo si el bot es público).
DAILY_MESSAGE_LIMIT=0

# Opcional: zona horaria por defecto para los recordatorios (ej. America/Lima).
# Cada chat puede cambiarla con /zona. Si la dejas vacía, el bot la pedirá al usar horas.
TIMEZONE=

# Dónde se guarda la base de datos SQLite (recordatorios y zonas horarias).
# En Railway: adjunta un Volume al servicio y se usará solo (Railway define
# RAILWAY_VOLUME_MOUNT_PATH). También puedes fijarla a mano, ej. DB_PATH=/data/reminders.db
# En local déjala vacía: se crea reminders.db en la carpeta del proyecto.
DB_PATH=

# Opcional: que el agente lea tus repos de GitHub (solo lectura).
# Crea un token "fine-grained" en GitHub > Settings > Developer settings, con permisos de
# SOLO LECTURA en Contents, Metadata, Issues y Pull requests, sobre los repos que quieras.
GITHUB_TOKEN=
# Ids de Telegram que pueden usarlo, separados por coma (mándale /id al bot). Sin esto no se activa:
# el bot es público y si no, cualquiera podría leer tus repos privados.
GITHUB_OWNER_IDS=

# Opcional: que el mismo agente atienda también en Discord (mensajes directos y menciones).
# Developer Portal > tu aplicación > Bot > Reset Token. Activa "Message Content Intent" ahí mismo.
DISCORD_TOKEN=
# Ids de Discord autorizados a RECIBIR mensajes directos del bot, separados por coma.
# Sin esta variable la herramienta send_discord_dm no se activa.
DISCORD_DM_IDS=
# Usuarios autorizados a pedir lecturas de Discord desde el propio Discord.
DISCORD_MONITOR_USER_IDS=
# IDs de Telegram autorizados a pedir lecturas de Discord.
DISCORD_MONITOR_TELEGRAM_IDS=
# Canales que Orion puede leer, separados por coma. No se consultan otros canales.
DISCORD_MONITOR_CHANNEL_IDS=
# Canales donde Orion puede publicar mensajes; separado de la lista de lectura.
DISCORD_WRITE_CHANNEL_IDS=
# true = primero prepara la publicación y espera confirmación explícita.
REQUIRE_APPROVAL_FOR_DISCORD=true
